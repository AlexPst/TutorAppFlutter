  "fixed_sql": [
    {
      "name": "students",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"students\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"full_name\" TEXT NOT NULL, \"phone\" TEXT NULL, \"telegram\" TEXT NULL, \"note\" TEXT NULL, \"grade_scale_min\" INTEGER NOT NULL DEFAULT 2, \"grade_scale_max\" INTEGER NOT NULL DEFAULT 5, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), CHECK (grade_scale_min < grade_scale_max));"
        }
      ]
    },
    {
      "name": "subjects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subjects\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "enrollments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"enrollments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"student_id\" INTEGER NOT NULL REFERENCES students (id) ON DELETE CASCADE, \"subject_id\" INTEGER NOT NULL REFERENCES subjects (id) ON DELETE RESTRICT, \"rate_kopecks\" INTEGER NOT NULL, \"default_duration_minutes\" INTEGER NOT NULL DEFAULT 60, \"note\" TEXT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"student_id\", \"subject_id\"), CHECK (rate_kopecks >= 0), CHECK (default_duration_minutes > 0));"
        }
      ]
    },
    {
      "name": "lesson_packages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lesson_packages\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"enrollment_id\" INTEGER NOT NULL REFERENCES enrollments (id) ON DELETE CASCADE, \"lessons_count\" INTEGER NOT NULL, \"price_kopecks\" INTEGER NOT NULL, \"purchased_at\" INTEGER NOT NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), CHECK (lessons_count > 0), CHECK (price_kopecks >= 0));"
        }
      ]
    },
    {
      "name": "lessons",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lessons\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"enrollment_id\" INTEGER NOT NULL REFERENCES enrollments (id) ON DELETE CASCADE, \"starts_at\" INTEGER NOT NULL, \"duration_minutes\" INTEGER NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'planned', \"price_kopecks\" INTEGER NOT NULL, \"package_id\" INTEGER NULL REFERENCES lesson_packages (id) ON DELETE SET NULL, \"topic\" TEXT NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), CHECK (duration_minutes > 0), CHECK (price_kopecks >= 0));"
        }
      ]
    },
    {
      "name": "payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"student_id\" INTEGER NOT NULL REFERENCES students (id) ON DELETE CASCADE, \"amount_kopecks\" INTEGER NOT NULL, \"paid_at\" INTEGER NOT NULL, \"method\" TEXT NOT NULL DEFAULT 'cardTransfer', \"comment\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), CHECK (amount_kopecks > 0));"
        }
      ]
    },
    {
      "name": "progress_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"progress_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"enrollment_id\" INTEGER NOT NULL REFERENCES enrollments (id) ON DELETE CASCADE, \"lesson_id\" INTEGER NULL UNIQUE REFERENCES lessons (id) ON DELETE CASCADE, \"entry_date\" INTEGER NOT NULL, \"topic\" TEXT NULL, \"grade\" INTEGER NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), CHECK (grade IS NOT NULL OR topic IS NOT NULL OR note IS NOT NULL));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
